# ==============================================================
# CGD Website Uptime Monitor Configuration
# Target Website: https://gcfa.cgd.go.th/login
# Alert Target: tripop.t.ba.project@gmail.com
# ==============================================================

# Target Settings (ค่าเริ่มต้นกำหนดไว้ในโค้ดแล้ว สามารถปรับเปลี่ยนได้ที่นี่)
TARGET_URL=https://gcfa.cgd.go.th/login
ALERT_TO_EMAIL=tripop.t.ba.project@gmail.com
CHECK_INTERVAL_SECONDS=120

# --------------------------------------------------------------
# Email Sending Configuration (SMTP - แนะนำ Gmail App Password)
# --------------------------------------------------------------
# สำหรับ Gmail:
# 1. เข้าไปที่ Google Account (https://myaccount.google.com/security)
# 2. เปิด 2-Step Verification
# 3. ค้นหา "App Passwords" (รหัสผ่านสำหรับแอป)
# 4. สร้าง App Password ใหม่ 16 หลัก แล้วนำมากรอกด้านล่าง
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME="CGD Web Monitor"

# --------------------------------------------------------------
# Security Token สำหรับ Vercel Cron หรือ External Cron (cron-job.org)
# --------------------------------------------------------------
# ป้องกันบุคคลภายนอกมายิง API เช็คเว็บโดยไม่ได้รับอนุญาต
CRON_SECRET=cgd_monitor_secret_key_2026
